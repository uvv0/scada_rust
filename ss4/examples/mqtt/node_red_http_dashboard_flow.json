  {
    "id": "http-store-values",
    "type": "function",
    "z": "ss4-http-tab",
    "name": "store latest values",
    "func": "let p = msg.payload || {};\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch (_) { p = {}; } }\nmsg.payload = p;\nconst rows = flow.get('latestValues') || {};\nconst values = Array.isArray(p.values) ? p.values : [];\nfor (const v of values) {\n    const key = `${p.kpz_id}/${v.reg_id}`;\n    rows[key] = {\n        ts: p.ts,\n        received_at: Date.now(),\n        kpz_id: p.kpz_id,\n        kpz_name: p.kpz_name || '',\n        group_id: v.group_id,\n        reg_id: v.reg_id,\n        addr: v.addr,\n        name: v.name || '',\n        tip: v.tip,\n        value: v.value,\n        quality: v.quality || ''\n    };\n}\nflow.set('latestValues', rows);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 220,
    "wires": [
      [
        "http-ws-out"
      ]
    ]
  },
