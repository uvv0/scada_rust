  },
  {
    "id": "ss4-dashboard-ui-tab",
    "type": "ui_tab",
    "name": "ss4",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "ss4-dashboard-ui-group-state",
    "type": "ui_group",
    "name": "State",
    "tab": "ss4-dashboard-ui-tab",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false,
    "className": ""
  },
  {
    "id": "ss4-dashboard-ui-group-values",
    "type": "ui_group",
    "name": "Latest values",
    "tab": "ss4-dashboard-ui-tab",
    "order": 2,
    "disp": true,
    "width": "24",
    "collapse": false,
    "className": ""
