  {
    "id": "ss4-dashboard-broker",
    "type": "mqtt-broker",
    "name": "local mosquitto",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "node-red-ss4-dashboard",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "5",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "dashboard-status-in",
    "type": "mqtt in",
    "z": "ss4-dashboard-tab",
    "name": "status",
    "topic": "ss4/v1/status",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "ss4-dashboard-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 120,
    "y": 80,
    "wires": [["dashboard-status-text"]]
  },
  {
    "id": "dashboard-status-text",
    "type": "ui_text",
    "z": "ss4-dashboard-tab",
    "group": "ss4-dashboard-ui-group-state",
    "order": 1,
    "width": "6",
    "height": "1",
    "name": "status",
    "label": "status",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "className": "",
    "x": 340,
    "y": 80,
    "wires": []
  },
  {
    "id": "dashboard-health-in",
    "type": "mqtt in",
    "z": "ss4-dashboard-tab",
    "name": "health",
    "topic": "ss4/v1/health",
    "qos": "1",
    "datatype": "json",
    "broker": "ss4-dashboard-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 120,
    "y": 140,
    "wires": [["dashboard-health-format"]]
  },
  {
    "id": "dashboard-health-format",
    "type": "function",
    "z": "ss4-dashboard-tab",
    "name": "format health",
    "func": "const p = msg.payload || {};\\nmsg.payload = `${p.kind || ''}: ${p.message || ''}`;\\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 140,
    "wires": [["dashboard-health-text"]]
  },
  {
    "id": "dashboard-health-text",
    "type": "ui_text",
    "z": "ss4-dashboard-tab",
    "group": "ss4-dashboard-ui-group-state",
    "order": 2,
    "width": "12",
    "height": "2",
    "name": "health",
    "label": "health",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "className": "",
    "x": 550,
    "y": 140,
    "wires": []
  },
  {
    "id": "dashboard-values-in",
    "type": "mqtt in",
    "z": "ss4-dashboard-tab",
    "name": "values",
    "topic": "ss4/v1/values/+",
    "qos": "1",
    "datatype": "json",
    "broker": "ss4-dashboard-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 120,
    "y": 220,
    "wires": [["dashboard-values-html"]]
  },
  {
    "id": "dashboard-values-init",
    "type": "inject",
    "z": "ss4-dashboard-tab",
    "name": "init values table",
    "props": [{"p": "payload"}],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "0.5",
    "topic": "",
    "payload": "{}",
    "payloadType": "json",
    "x": 130,
    "y": 260,
    "wires": [["dashboard-values-html"]]
  },
  {
    "id": "dashboard-values-html",
    "type": "function",
    "z": "ss4-dashboard-tab",
    "name": "latest values html",
    "func": "const p = msg.payload || {};\\nconst rows = flow.get('latestValues') || {};\\nconst values = Array.isArray(p.values) ? p.values : [];\\nfor (const v of values) {\\n    const key = `${p.kpz_id}/${v.reg_id}`;\\n    rows[key] = {\\n        kpz_id: p.kpz_id,\\n        kpz_name: p.kpz_name || '',\\n        group_id: v.group_id || '',\\n        reg_id: v.reg_id,\\n        addr: v.addr || '',\\n        name: v.name || '',\\n        value: v.value,\\n        quality: v.quality || ''\\n    };\\n}\\nflow.set('latestValues', rows);\\nconst sorted = Object.values(rows).sort((a, b) => a.kpz_id - b.kpz_id || Number(a.group_id) - Number(b.group_id) || a.reg_id - b.reg_id);\\nconst lines = ['kpz\\tkpz_name\\tgroup\\treg\\taddr\\tname\\tvalue\\tquality'];\\nif (sorted.length === 0) {\\n    lines.push('waiting for ss4/v1/values/+');\\n} else {\\n    for (const r of sorted) {\\n        lines.push(`${r.kpz_id}\\t${r.kpz_name}\\t${r.group_id}\\t${r.reg_id}\\t${r.addr}\\t${r.name}\\t${r.value}\\t${r.quality}`);\\n    }\\n}\\nmsg.payload = lines.join('\\n');\\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 220,
    "wires": [["dashboard-values-template"]]
  },
  {
    "id": "dashboard-values-template",
    "type": "ui_text",
    "z": "ss4-dashboard-tab",
    "group": "ss4-dashboard-ui-group-values",
    "name": "latest values",
    "order": 1,
    "width": "24",
    "height": "4",
    "label": "values",
    "format": "{{msg.payload}}",
    "layout": "col-center",
    "className": "",
    "x": 590,
    "y": 220,
    "wires": []
  },
  {
    "id": "dashboard-alarms-in",
    "type": "mqtt in",
    "z": "ss4-dashboard-tab",
    "name": "alarms",
    "topic": "ss4/v1/alarms/+/+",
    "qos": "1",
    "datatype": "json",
    "broker": "ss4-dashboard-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 120,
    "y": 300,
    "wires": [["dashboard-alarms-html"]]
  },
  {
    "id": "dashboard-alarms-init",
    "type": "inject",
    "z": "ss4-dashboard-tab",
    "name": "init alarms table",
    "props": [{"p": "payload"}],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "0.5",
    "topic": "",
    "payload": "{}",
    "payloadType": "json",
    "x": 130,
    "y": 340,
    "wires": [["dashboard-alarms-html"]]
  },
  {
    "id": "dashboard-alarms-html",
    "type": "function",
    "z": "ss4-dashboard-tab",
    "name": "latest alarms html",
    "func": "const p = msg.payload || {};\\nconst rows = flow.get('latestAlarms') || [];\\nif (p.event || p.rule_id !== undefined) {\\n    rows.unshift({\\n        at: new Date().toLocaleString(),\\n        kpz_id: p.kpz_id,\\n        reg_id: p.reg_id,\\n        rule_id: p.rule_id,\\n        event: p.event,\\n        value: p.value,\\n        severity: p.severity,\\n        code: p.code || '',\\n        message: p.message || ''\\n    });\\n}\\nconst trimmed = rows.slice(0, 50);\\nflow.set('latestAlarms', trimmed);\\nconst lines = ['time\\tkpz\\treg\\trule\\tevent\\tvalue\\tsev\\tcode\\tmessage'];\\nif (trimmed.length === 0) {\\n    lines.push('waiting for ss4/v1/alarms/+/+');\\n} else {\\n    for (const r of trimmed) {\\n        lines.push(`${r.at}\\t${r.kpz_id}\\t${r.reg_id}\\t${r.rule_id}\\t${r.event}\\t${r.value}\\t${r.severity}\\t${r.code}\\t${r.message}`);\\n    }\\n}\\nmsg.payload = lines.join('\\n');\\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 300,
    "wires": [["dashboard-alarms-template"]]
  },
  {
    "id": "dashboard-alarms-template",
    "type": "ui_text",
    "z": "ss4-dashboard-tab",
    "group": "ss4-dashboard-ui-group-alarms",
    "name": "latest alarms",
    "order": 1,
    "width": "24",
    "height": "4",
    "label": "alarms",
    "format": "{{msg.payload}}",
    "layout": "col-center",
    "className": "",
    "x": 590,
    "y": 300,
    "wires": []
  }
]
