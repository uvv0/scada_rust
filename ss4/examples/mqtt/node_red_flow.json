[
  {
    "id": "ss4-tab",
    "type": "tab",
    "label": "ss4 MQTT",
    "disabled": false,
    "info": "Minimal ss4 MQTT viewer flow"
  },
  {
    "id": "ss4-broker",
    "type": "mqtt-broker",
    "name": "local mosquitto",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "node-red-ss4",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "5",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "mqtt-status",
    "type": "mqtt in",
    "z": "ss4-tab",
    "name": "status",
    "topic": "ss4/v1/status",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "ss4-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 80,
    "wires": [["debug-status"]]
  },
  {
    "id": "mqtt-health",
    "type": "mqtt in",
    "z": "ss4-tab",
    "name": "health",
    "topic": "ss4/v1/health",
    "qos": "1",
    "datatype": "json",
    "broker": "ss4-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 140,
    "wires": [["debug-health"]]
  },
  {
    "id": "mqtt-values",
    "type": "mqtt in",
    "z": "ss4-tab",
    "name": "values",
    "topic": "ss4/v1/values/+",
    "qos": "1",
    "datatype": "json",
    "broker": "ss4-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 200,
    "wires": [["flatten-values", "latest-values"]]
  },
  {
    "id": "mqtt-alarms",
    "type": "mqtt in",
    "z": "ss4-tab",
    "name": "alarms",
    "topic": "ss4/v1/alarms/+/+",
    "qos": "1",
    "datatype": "json",
    "broker": "ss4-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 300,
    "wires": [["debug-alarms"]]
  },
  {
    "id": "flatten-values",
    "type": "function",
    "z": "ss4-tab",
    "name": "flatten values",
    "func": "const p = msg.payload || {};\\nconst values = Array.isArray(p.values) ? p.values : [];\\nreturn values.map(v => ({\\n    topic: `${p.kpz_id}/${v.reg_id}`,\\n    payload: {\\n        ts: p.ts,\\n        kpz_id: p.kpz_id,\\n        kpz_name: p.kpz_name,\\n        reg_id: v.reg_id,\\n        addr: v.addr,\\n        name: v.name,\\n        group_id: v.group_id,\\n        tip: v.tip,\\n        value: v.value,\\n        quality: v.quality\\n    }\\n}));",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 200,
    "wires": [["debug-values"]]
  },
  {
    "id": "debug-status",
    "type": "debug",
    "z": "ss4-tab",
    "name": "status",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 350,
    "y": 80,
    "wires": []
  },
  {
    "id": "latest-values",
    "type": "function",
    "z": "ss4-tab",
    "name": "latest values table",
    "func": "const p = msg.payload || {};\\nconst rows = flow.get('latestValues') || {};\\nconst values = Array.isArray(p.values) ? p.values : [];\\nfor (const v of values) {\\n    const key = `${p.kpz_id}/${v.reg_id}`;\\n    rows[key] = {\\n        ts: p.ts,\\n        kpz_id: p.kpz_id,\\n        kpz_name: p.kpz_name || '',\\n        reg_id: v.reg_id,\\n        addr: v.addr,\\n        name: v.name || '',\\n        group_id: v.group_id,\\n        tip: v.tip,\\n        value: v.value,\\n        quality: v.quality\\n    };\\n}\\nflow.set('latestValues', rows);\\nmsg.payload = Object.values(rows).sort((a, b) =>\\n    a.kpz_id - b.kpz_id || a.group_id - b.group_id || a.reg_id - b.reg_id\\n);\\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 250,
    "wires": [["debug-latest-values"]]
  },
  {
    "id": "debug-latest-values",
    "type": "debug",
    "z": "ss4-tab",
    "name": "latest values table",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 590,
    "y": 250,
    "wires": []
  },
